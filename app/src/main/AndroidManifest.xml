<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network reaches anything: the offline banners and the queue of writes waiting for one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Episodes downloading in the background, which is a data sync as the platform classifies it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Voice clips during a shared viewing. Asked for at the first hold of the button, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!--
      Declared optional, like the two below it. A RECORD_AUDIO permission on its own makes Play
      treat a microphone as required hardware and filter the app off every device without one —
      which includes television boxes, and this app ships a television build.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".KaeruApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaeru">

        <!-- How the Cast framework finds our receiver id; it builds the class itself. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.kaeru.player.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kaeru.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  One scheme, three hosts, written as separate tags: the platform merges every
                  data element in a filter and matches the cross product, so this is
                  `kaeru://oauth` (the OAuth callback), `kaeru://pair` (a television's QR code,
                  read by the phone and never fired by this app) and `kaeru://watch` (an
                  invitation: a phone on this Wi-Fi, or the relay room the landing page's
                  button opens when a browser will not hand its own address to an app), and
                  nothing else.
                -->
                <data android:scheme="kaeru" />
                <data android:host="oauth" />
                <data android:host="pair" />
                <data android:host="watch" />
            </intent-filter>
            <!--
              The invitation as it travels through a messenger. Verified rather than merely
              declared: the host serves `/.well-known/assetlinks.json` naming this package and
              both signing certificates, so the system makes Kaeru the default handler and the
              link opens the app instead of a browser tab. Verification is asynchronous and takes
              a moment after install, which is why the page behind the same address has a button
              that fires the link again.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="kaeru.vitaliy.velikodniy.name"
                    android:pathPrefix="/w/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.mobile.player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Kaeru" />

        <service
            android:name=".player.KaeruPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Downloads run here, always in the foreground: a transfer without a foreground
          notification is one Android stops as soon as the app leaves the screen. Nothing outside
          the app addresses it, and media3's own restart intent is explicit, so it needs no filter.
        -->
        <service
            android:name=".data.download.KaeruDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Kaeru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
