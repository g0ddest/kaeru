{
  "about": "Sync and «украдкой» rules as input -> expected output. Source of truth: shared/src/commonMain/kotlin/app/kaeru/shared/domain/sync. Run by the shared module (SyncVectorsTest), and meant to be run by the web client, the worker (infra/relay/src/sync.ts) and Swift. All times are epoch milliseconds. A title is the /sync wire form: {dub?: {id, title, at}, eps?: {\"<episode>\": {p, d, at}}, secret?: {on, watched, at}, gone?}; an absent field is left out, never null; titles (and remote/expected documents) are keyed by anime id as a string. merge/without: base (or null), patch, title, covered -> expected title. newer: remote titles + local state -> what to write; positions and secrets compare without regard to order. seed: local state, finished anime ids, remote -> titles to merge into the outbox. wireParse: raw response text -> titles, or null when unreadable. wireSerialize: titles -> expected (the POST body as a JSON object) and text (the exact bytes the Kotlin codec writes). secret*: counted is Shikimori's episode count, null when there is no rate; a null expected means nothing is written or sent.",
  "constants": {"episodesPerTitle": 30, "maxDubTitle": 200},
  "merge": [
    {"name": "into nothing, the patch is the title", "base": null, "patch": {"dub": {"id": 610, "title": "AniLibria.TV", "at": 10}, "eps": {"1": {"p": 5, "d": 9, "at": 11}}}, "expected": {"dub": {"id": 610, "title": "AniLibria.TV", "at": 10}, "eps": {"1": {"p": 5, "d": 9, "at": 11}}}},
    {"name": "newer dub wins, older loses, a tie goes to the patch", "base": {"dub": {"id": 1, "title": "Old", "at": 10}}, "patch": {"dub": {"id": 2, "title": "New", "at": 20}}, "expected": {"dub": {"id": 2, "title": "New", "at": 20}}},
    {"name": "an older dub does not replace a newer one", "base": {"dub": {"id": 2, "title": "New", "at": 20}}, "patch": {"dub": {"id": 1, "title": "Old", "at": 10}}, "expected": {"dub": {"id": 2, "title": "New", "at": 20}}},
    {"name": "a dub with the same stamp replaces the base", "base": {"dub": {"id": 1, "title": "A", "at": 10}}, "patch": {"dub": {"id": 2, "title": "B", "at": 10}}, "expected": {"dub": {"id": 2, "title": "B", "at": 10}}},
    {"name": "episodes merge one by one, the newer of each winning", "base": {"eps": {"1": {"p": 100, "d": 1000, "at": 10}, "2": {"p": 200, "d": 1000, "at": 30}}}, "patch": {"eps": {"1": {"p": 150, "d": 1000, "at": 20}, "2": {"p": 250, "d": 1000, "at": 25}, "3": {"p": 300, "d": 1000, "at": 5}}}, "expected": {"eps": {"1": {"p": 150, "d": 1000, "at": 20}, "2": {"p": 200, "d": 1000, "at": 30}, "3": {"p": 300, "d": 1000, "at": 5}}}},
    {"name": "fields the patch lacks are kept", "base": {"dub": {"id": 1, "title": "A", "at": 10}, "secret": {"on": true, "watched": 3, "at": 10}, "gone": 5}, "patch": {"eps": {"1": {"p": 1, "d": 2, "at": 3}}}, "expected": {"dub": {"id": 1, "title": "A", "at": 10}, "secret": {"on": true, "watched": 3, "at": 10}, "gone": 5, "eps": {"1": {"p": 1, "d": 2, "at": 3}}}},
    {"name": "a later tombstone replaces an earlier one, an earlier does not", "base": {"gone": 50}, "patch": {"gone": 40}, "expected": {"gone": 50}},
    {"name": "a tombstone in the patch is merged like any field; older episodes stay (the worker, not merge, drops them)", "base": {"eps": {"1": {"p": 1, "d": 2, "at": 3}}}, "patch": {"gone": 40}, "expected": {"eps": {"1": {"p": 1, "d": 2, "at": 3}}, "gone": 40}},
    {"name": "secret: newer wins either way round (1)", "base": {"secret": {"on": true, "watched": 2, "at": 10}}, "patch": {"secret": {"on": false, "watched": 5, "at": 20}}, "expected": {"secret": {"on": false, "watched": 5, "at": 20}}},
    {"name": "secret: newer wins either way round (2)", "base": {"secret": {"on": false, "watched": 5, "at": 20}}, "patch": {"secret": {"on": true, "watched": 2, "at": 10}}, "expected": {"secret": {"on": false, "watched": 5, "at": 20}}},
    {"name": "an empty episode map in the patch leaves an empty map", "base": null, "patch": {"eps": {}}, "expected": {"eps": {}}},
    {"name": "an empty patch changes nothing", "base": {"gone": 7}, "patch": {}, "expected": {"gone": 7}}
  ],
  "without": [
    {"name": "what the covering title holds as new or newer is spent", "title": {"dub": {"id": 1, "title": "A", "at": 10}, "eps": {"1": {"p": 1, "d": 9, "at": 10}, "2": {"p": 2, "d": 9, "at": 20}}, "secret": {"on": true, "watched": 2, "at": 10}}, "covered": {"dub": {"id": 1, "title": "A", "at": 10}, "eps": {"1": {"p": 1, "d": 9, "at": 10}, "2": {"p": 2, "d": 9, "at": 15}}, "secret": {"on": false, "watched": 5, "at": 20}}, "expected": {"eps": {"2": {"p": 2, "d": 9, "at": 20}}}},
    {"name": "newer than what is covered is kept", "title": {"dub": {"id": 2, "title": "B", "at": 30}, "secret": {"on": false, "watched": 5, "at": 20}}, "covered": {"dub": {"id": 1, "title": "A", "at": 10}, "secret": {"on": true, "watched": 2, "at": 10}}, "expected": {"dub": {"id": 2, "title": "B", "at": 30}, "secret": {"on": false, "watched": 5, "at": 20}}},
    {"name": "anything stamped at or before the covering tombstone is spent", "title": {"dub": {"id": 2, "title": "B", "at": 20}, "eps": {"1": {"p": 1, "d": 9, "at": 20}, "2": {"p": 1, "d": 9, "at": 21}}, "secret": {"on": true, "watched": 5, "at": 20}, "gone": 20}, "covered": {"gone": 20}, "expected": {"eps": {"2": {"p": 1, "d": 9, "at": 21}}}},
    {"name": "a later tombstone than the covering one is kept", "title": {"gone": 30}, "covered": {"gone": 20}, "expected": {"gone": 30}},
    {"name": "nothing covered keeps everything", "title": {"dub": {"id": 1, "title": "A", "at": 1}, "eps": {"3": {"p": 1, "d": 2, "at": 3}}, "secret": {"on": true, "watched": 0, "at": 1}, "gone": 1}, "covered": {}, "expected": {"dub": {"id": 1, "title": "A", "at": 1}, "eps": {"3": {"p": 1, "d": 2, "at": 3}}, "secret": {"on": true, "watched": 0, "at": 1}, "gone": 1}},
    {"name": "all spent is empty; an empty episode map reads as none", "title": {"eps": {"1": {"p": 1, "d": 2, "at": 3}}}, "covered": {"eps": {"1": {"p": 1, "d": 2, "at": 3}}}, "expected": {}},
    {"name": "the tombstone floor applies even with no field to compare against", "title": {"secret": {"on": false, "watched": 5, "at": 20}}, "covered": {"gone": 20}, "expected": {}}
  ],
  "newer": [
    {"name": "nothing from the server, nothing to write", "remote": {}, "local": {"positions": [{"animeId": 5, "episode": 1, "positionMs": 0, "durationMs": 0, "at": 10}], "dubs": {}, "dubStamps": {}, "secrets": {}}, "expected": {"positions": [], "tombstones": {}, "dubs": {}, "dubStamps": {}, "secrets": []}},
    {"name": "a position goes in over none or an older one, not over an equal or newer one", "remote": {"5": {"eps": {"1": {"p": 100, "d": 1000, "at": 20}, "2": {"p": 200, "d": 1000, "at": 20}, "3": {"p": 300, "d": 1000, "at": 20}, "4": {"p": 400, "d": 1000, "at": 20}}}}, "local": {"positions": [{"animeId": 5, "episode": 1, "positionMs": 0, "durationMs": 0, "at": 10}, {"animeId": 5, "episode": 2, "positionMs": 0, "durationMs": 0, "at": 20}, {"animeId": 5, "episode": 3, "positionMs": 0, "durationMs": 0, "at": 30}], "dubs": {}, "dubStamps": {}, "secrets": {}}, "expected": {"positions": [{"animeId": 5, "episode": 1, "positionMs": 100, "durationMs": 1000, "at": 20}, {"animeId": 5, "episode": 4, "positionMs": 400, "durationMs": 1000, "at": 20}], "tombstones": {}, "dubs": {}, "dubStamps": {}, "secrets": []}},
