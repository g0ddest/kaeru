    {"name": "every tombstone is passed on as it is", "remote": {"5": {"gone": 40}, "6": {"gone": 1}}, "local": {"positions": [{"animeId": 5, "episode": 1, "positionMs": 0, "durationMs": 0, "at": 50}], "dubs": {}, "dubStamps": {}, "secrets": {}}, "expected": {"positions": [], "tombstones": {"5": 40, "6": 1}, "dubs": {}, "dubStamps": {}, "secrets": []}},
