{
  "about": "Player rules as input -> expected output. Source of truth: shared/src/commonMain/kotlin/app/kaeru/shared/domain/playback. Run by the shared module (PlaybackVectorsTest), and meant to be run by the web client and Swift as well. Times are milliseconds; nextEpisodeAtMs/nowMs are epoch milliseconds. A track is {id, title, kind: voice|subtitles, episodes: number|null}. Orders are positions (0-based) in the given tracks list. Thresholds are fractions compared as 32-bit floats in Kotlin; the cases stay clear of rounding edges.",
  "constants": {
    "defaultStudios": ["AniLibria", "AniDUB", "Crunchyroll", "Amazing Dubbing", "AniBaza", "AniMaunt", "JAM", "Dream Cast", "SHIZA Project"],
    "oftenChosenFrom": 2,
    "startedMs": 60000,
    "startedFraction": 0.02,
    "defaultWatchedThreshold": 0.9,
    "nextEpisodeLeadMs": 30000,
    "autoplayCountdownSec": 10,
    "skipButtonWindowMs": 10000,
    "openingStartsWithinMs": 300000,
    "endingEndsWithinMs": 180000,
    "skipMinLengthMs": 60000,
    "skipMaxLengthMs": 150000,
    "seekSettleMs": 1000
  },
