<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <!-- Some Android 12+ devices permit transfer despite allowBackup=false. -->
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
