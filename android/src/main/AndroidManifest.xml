<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network reaches anything: the offline banners and the queue of writes waiting for one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Episodes downloading in the background, which is a data sync as the platform classifies it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Voice clips during a shared viewing. Asked for at the first hold of the button, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Updating the app from its own «Обновления» screen. This app is not on any store, so the
      only way a new version reaches a device is a release APK downloaded from GitHub and handed
      to the system installer — and the system refuses to open one for an app that has not
      declared this. It is not a silent install and cannot become one: the viewer still grants
      «установка из этого источника» once, and answers the installer itself every time.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!--
      Declared optional, like the two below it. A RECORD_AUDIO permission on its own makes Play
      treat a microphone as required hardware and filter the app off every device without one —
      which includes television boxes, and this app ships a television build.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".KaeruApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaeru">

        <!-- Firebase starts with both collectors off; Reporting.install switches them on only when
             the viewer has not said no in Settings, so a «no» holds from the first frame. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- How the Cast framework finds our receiver id; it builds the class itself. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.kaeru.player.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kaeru.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  One scheme, three hosts, written as separate tags: the platform merges every
                  data element in a filter and matches the cross product, so this is
                  `kaeru://oauth` (the OAuth callback), `kaeru://pair` (a television's QR code,
                  read by the phone and never fired by this app) and `kaeru://watch` (an
                  invitation: a phone on this Wi-Fi, or the relay room the landing page's
                  button opens when a browser will not hand its own address to an app), and
                  nothing else.
                -->
                <data android:scheme="kaeru" />
                <data android:host="oauth" />
                <data android:host="pair" />
                <data android:host="watch" />
            </intent-filter>
            <!--
              The invitation as it travels through a messenger. Verified rather than merely
              declared: the host serves `/.well-known/assetlinks.json` naming this package and
              both signing certificates, so the system makes Kaeru the default handler and the
              link opens the app instead of a browser tab. Verification is asynchronous and takes
              a moment after install, which is why the page behind the same address has a button
              that fires the link again.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="kaeru.vitaliy.velikodniy.name"
                    android:pathPrefix="/w/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.mobile.player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Kaeru" />

        <service
            android:name=".player.KaeruPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Downloads run here, always in the foreground: a transfer without a foreground
          notification is one Android stops as soon as the app leaves the screen. Nothing outside
          the app addresses it, and media3's own restart intent is explicit, so it needs no filter.
        -->
        <service
            android:name=".data.download.KaeruDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          How a downloaded release APK reaches the system installer, which runs in another
          process and cannot open a path inside this app's cache. A `file://` URI has been
          refused since Android 7; this hands out a `content://` one instead, readable only for
          as long as the intent that carries the grant. Not exported: nothing addresses it except
          this app, and the grant is what gives the installer its one-time access.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager is built on demand from `KaeruApp` rather than by its own startup provider,
          so the provider is taken out of the merged manifest. Without this the library would
          initialise itself first, with the default worker factory, and the new-episode worker —
          which is built by Hilt — would fail to start at all.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Kaeru">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
